ta-wiz-uids="uIrpqf_47,uIrpqf_46,uIrpqf_48" data-complete="true" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="" jsaction="click:&amp;uIrpqf_45|ZUljYd" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><span class=""><span class=""><!--qkimaf uIrpqf_45/HugV6--><!--cqw1tb uIrpqf_45/HugV6--><button jsuid="uIrpqf_46" tabindex="0" data-amic="true" data-icl-uuid="f54664b3-49b4-4ea3-a1cf-cffa83dc9ae7" aria-label="Related results" class="vDOt8c" jsaction="click:&amp;uIrpqf_45|CXhG2e;mouseenter:&amp;uIrpqf_45|wndyDd;mouseleave:&amp;uIrpqf_45|yrMC6" data-ved="2ahUKEwjy1ruV-sWXAxV_keEIHXf1OsIQye0OegYIAAgZEAM" data-hveid="CAAIGRAD"><span class="pxxQye T6UJT"><div class="a14YJe"><svg class="EQxvpc MZhYme" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960" aria-hidden="true" jsaction="" jscontroller="vODoFe#cKfyCe" data-sfc-root="ep" data-epip="" jsuid="uIrpqf_49" data-complete="true"><path d="M440-280H280q-83,0-141.5-58.5T80-480t58.5-141.5T280-680H440v80H280q-50,0-85,35t-35,85t35,85t85,35H440v80ZM320-440v-80H640v80H320ZM520-280v-80H680q50,0 85-35t35-85t-35-85t-85-35H520v-80H680q83,0 141.5,58.5T880-480T821.5-338.5T680-280H520Z"></path><!--TgQPHd|||[]--></svg></div></span><div jsuid="uIrpqf_47" style="display: none;" data-ved="2ahUKEwjy1ruV-sWXAxV_keEIHXf1OsIQlZkRegYIAAgZEAQ"></div></button></span></span></span><!--qkimaf uIrpqf_45/WyzG9e--><!--cqw1tb uIrpqf_45/WyzG9e--><!--TgQPHd|||[[&quot;f54664b3-49b4-4ea3-a1cf-cffa83dc9ae7&quot;,null,null,0,&quot;&quot;,&quot;&quot;,0,null,null,null,null,0,null,0]]--></span><!--TgQPHd|||[]--></li><!--TgQPHd|||[]--></ol><div class="yhAwj" data-sfc-cp="" jsaction="rcuQ6b:&amp;uIrpqf_4a|npT2md" jscontroller="UTzWVc#U8DOt" data-sfc-root="ep" data-epip="" jsuid="uIrpqf_4a" data-complete="true" data-processed="true" data-sfc-inited="2"><!--TgQPHd|||[]--></div><div jsuid="uIrpqf_4b" class="BpxUDf aiModeUiCodeBlock__Container" data-sfc-cp="" jsaction="" jscontroller="Liu6s#lcO7sb" data-sfc-root="ep" data-epip="" data-wiz-uids="uIrpqf_4d,uIrpqf_4c" data-hveid="CAAIGhAA" data-complete="true" data-processed="true"><div data-processed="true"><div class="rq1a2" data-animation-atomic="" data-sae="" style=""><div class="a2TNg"><div class="GlO4G">python</div></div><div class="PGvq2d" dir="ltr"><pre><code jsuid="uIrpqf_4d"><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">pandas</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> pd
</span><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">numpy</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> np
</span><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">matplotlib</span><span class="undefined">.</span><span class="yqj1Pc">pyplot</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> plt
</span><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">seaborn</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> sns

</span><span class="ojrtQ"># 1. Load the raw dataset</span><span class="undefined">
</span><span class="yqj1Pc">df</span><span class="undefined"> = pd.read_csv(</span><span class="dk3nFb">'</span><span class="dk3nFb">raw_dataset.csv</span><span class="dk3nFb">'</span><span class="undefined">)

</span><span class="ojrtQ"># 2. Clean data fields (Removes exact row duplicates)</span><span class="undefined">
</span><span class="yqj1Pc">df</span><span class="undefined"> = df.drop_duplicates()

</span><span class="ojrtQ"># 3. Clean metric columns (Filter out impossible outlier rows)</span><span class="undefined">
</span><span class="yqj1Pc">df</span><span class="undefined"> = df[(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">] &gt; </span><span class="N1kUHb">0</span><span class="undefined">) &amp; (df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">] &lt; </span><span class="N1kUHb">100</span><span class="undefined">)]
</span><span class="yqj1Pc">df</span><span class="undefined"> = df[(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">] &gt;= </span><span class="N1kUHb">0</span><span class="undefined">) &amp; (df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">] &lt;= </span><span class="N1kUHb">100</span><span class="undefined">)]

</span><span class="ojrtQ"># 4. Handle remaining missing value entries using column medians</span><span class="undefined">
df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">] = df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">].fillna(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">].median())
df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Study_Hours</span><span class="dk3nFb">'</span><span class="undefined">] = df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Study_Hours</span><span class="dk3nFb">'</span><span class="undefined">].fillna(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Study_Hours</span><span class="dk3nFb">'</span><span class="undefined">].median())
df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">] = df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">].fillna(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">].median())

</span><span class="ojrtQ"># 5. Export clean database file</span><span class="undefined">
df.to_csv(</span><span class="dk3nFb">'</span><span class="dk3nFb">cleaned_dataset.csv</span><span class="dk3nFb">'</span><span class="undefined">, index=</span><span class="uiJ0Tc">False</span><span class="undefined">)
</span></code></pre></div></div><div class="iMHp6c" data-animation-atomic="" data-sae="" style=""><div class="ZIumpf">Use code with caution.</div><span jsuid="uIrpqf_4c" jsaction="action:&amp;uIrpqf_4b|ZUljYd" data-ved="2ahUKEwjy1ruV-sWXAxV_keEIHXf1OsIQopQPegYIAAgaEAE"><div jsuid="uIrpqf_4e" data-sfc-cp="" jsaction="" jscontroller="cXTEid#e0nEwf" data-sfc-root="ep" data-epip="" data-ved="2ahUKEwjy1ruV-sWXAxV_keEIHXf1OsIQh9gSegYIAAgaEAI" data-complete="true"><button jsuid="uIrpqf_4f" class="FTsWP RmjGdc IsqrXb" id="" aria-label="Copy code text to clipboard." data-tooltip-classes="undefined" data-is-tooltip-wrapper="undefined" data-tooltip-id="undefined" aria-describedby="" data-sfc-cp="" jsaction="pointerdown:&amp;uIrpqf_4f|ZUljYd;pointerup:&amp;uIrpqf_4f|aXD3Gb;pointerenter:&amp;uIrpqf_4f|Mrjwi;pointerleave:&amp;uIrpqf_4f|CXhG2e;pointercancel:&amp;uIrpqf_4f|wndyDd;contextmenu:&amp;uIrpqf_4f|yrMC6;click:&amp;uIrpqf_4f|w9rIQb;focus:&amp;uIrpqf_4f|SAMwlb;blur:&amp;uIrpqf_4f|hQOfOb;" data-wiz-attrbind="disabled=uIrpqf_4f/ggNWmb;aria-label=uIrpqf_4f/mCevaf" jscontroller="ETNkje#SiNNTb" data-sfc-root="c" data-complete="true"><span class="XjoK4b kkxvEb" jsaction="" jscontroller="bJ5zY#LlrZ1b" data-sfc-root="c" jsuid="uIrpqf_4g" data-complete="true"><!--TgQPHd|||[]--></span><span jsuid="uIrpqf_4h" class="UTNHae" jsaction="QBlI0e:&amp;uIrpqf_4h|JwG8nd;BTifte:&amp;uIrpqf_4h|ie0cXb;nqgE9d:&amp;uIrpqf_4h|LZznfb;fHTtBd:&amp;uIrpqf_4h|i8hBpd;" data-wiz-attrbind="class=uIrpqf_4h/ggNWmb" jscontroller="MAxPne#DBBRWd" data-sfc-root="c" data-complete="true"><!--TgQPHd|||[{&quot;u&quot;:0},false]--></span><span class="I36Cje" aria-hidden="true"><!--qkimaf uIrpqf_4b/HugV6--><svg aria-hidden="true" fill="currentColor" height="18px" viewBox="0 -960 960 960" width="18px"><path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"></path></svg><!--cqw1tb uIrpqf_4b/HugV6--></span><div class="ypuoue"></div><!--TgQPHd|||[&quot;Copy code text to clipboard.&quot;,false,{&quot;u&quot;:0},&quot;\u0026uIrpqf_4e:UEmoBd&quot;,{&quot;u&quot;:0}]--></button><!--TgQPHd||GVEHxc=*Q0pj3b|[]--></div></span></div></div><!--TgQPHd|||[[&quot;python&quot;,&quot;import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# 1. Load the raw dataset\ndf \u003d pd.read_csv(&#39;raw_dataset.csv&#39;)\n\n# 2. Clean data fields (Removes exact row duplicates)\ndf \u003d df.drop_duplicates()\n\n# 3. Clean metric columns (Filter out impossible outlier rows)\ndf \u003d df[(df[&#39;Age&#39;] \u003e 0) \u0026 (df[&#39;Age&#39;] \u003c 100)]\ndf \u003d df[(df[&#39;Exam_Score&#39;] \u003e\u003d 0) \u0026 (df[&#39;Exam_Score&#39;] \u003c\u003d 100)]\n\n# 4. Handle remaining missing value entries using column medians\ndf[&#39;Age&#39;] \u003d df[&#39;Age&#39;].fillna(df[&#39;Age&#39;].median())\ndf[&#39;Study_Hours&#39;] \u003d df[&#39;Study_Hours&#39;].fillna(df[&#39;Study_Hours&#39;].median())\ndf[&#39;Exam_Score&#39;] \u003d df[&#39;Exam_Score&#39;].fillna(df[&#39;Exam_Score&#39;].median())\n\n# 5. Export clean database file\ndf.to_csv(&#39;cleaned_dataset.csv&#39;, index\u003dFalse)\n&quot;,[[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;pandas&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; pd\n&quot;,0],[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;numpy&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; np\n&quot;,0],[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;matplotlib&quot;,24],[&quot;.&quot;,0],[&quot;pyplot&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; plt\n&quot;,0],[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;seaborn&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; sns\n\n&quot;,0],[&quot;# 1. Load the raw dataset&quot;,5],[&quot;\n&quot;,0],[&quot;df&quot;,24],[&quot; \u003d pd.read_csv(&quot;,0],[&quot;&#39;&quot;,4],[&quot;raw_dataset.csv&quot;,4],[&quot;&#39;&quot;,4],[&quot;)\n\n&quot;,0],[&quot;# 2. Clean data fields (Removes exact row duplicates)&quot;,5],[&quot;\n&quot;,0],[&quot;df&quot;,24],[&quot; \u003d df.drop_duplicates()\n\n&quot;,0],[&quot;# 3. Clean metric columns (Filter out impossible outlier rows)&quot;,5],[&quot;\n&quot;,0],[&quot;df&quot;,24],[&quot; \u003d df[(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003e &quot;,0],[&quot;0&quot;,6],[&quot;) \u0026 (df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003c &quot;,0],[&quot;100&quot;,6],[&quot;)]\n&quot;,0],[&quot;df&quot;,24],[&quot; \u003d df[(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003e\u003d &quot;,0],[&quot;0&quot;,6],[&quot;) \u0026 (df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003c\u003d &quot;,0],[&quot;100&quot;,6],[&quot;)]\n\n&quot;,0],[&quot;# 4. Handle remaining missing value entries using column medians&quot;,5],[&quot;\ndf[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003d df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;].fillna(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;].median())\ndf[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Study_Hours&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003d df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Study_Hours&quot;,4],[&quot;&#39;&quot;,4],[&quot;].fillna(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Study_Hours&quot;,4],[&quot;&#39;&quot;,4],[&quot;].median())\ndf[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003d df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;].fillna(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;].median())\n\n&quot;,0],[&quot;# 5. Export cle