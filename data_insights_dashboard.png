</span><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">numpy</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> np
</span><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">matplotlib</span><span class="undefined">.</span><span class="yqj1Pc">pyplot</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> plt
</span><span class="uiJ0Tc">import</span><span class="undefined"> </span><span class="yqj1Pc">seaborn</span><span class="undefined"> </span><span class="uiJ0Tc">as</span><span class="undefined"> sns

</span><span class="ojrtQ"># 1. Load the raw dataset</span><span class="undefined">
</span><span class="ojrtQ"># Replace 'raw_data.csv' with your actual file path</span><span class="undefined">
</span><span class="yqj1Pc">df</span><span class="undefined"> = pd.read_csv(</span><span class="dk3nFb">'</span><span class="dk3nFb">raw_data.csv</span><span class="dk3nFb">'</span><span class="undefined">)
print(</span><span class="dk3nFb">"</span><span class="dk3nFb">Initial Shape:</span><span class="dk3nFb">"</span><span class="undefined">, df.shape)

</span><span class="ojrtQ"># 2. Remove exact duplicates</span><span class="undefined">
</span><span class="yqj1Pc">df</span><span class="undefined"> = df.drop_duplicates()
print(</span><span class="dk3nFb">"</span><span class="dk3nFb">Shape after removing duplicates:</span><span class="dk3nFb">"</span><span class="undefined">, df.shape)

</span><span class="ojrtQ"># 3. Handle Outliers</span><span class="undefined">
</span><span class="ojrtQ"># Check summary statistics to locate outliers</span><span class="undefined">
print(df.describe())

</span><span class="ojrtQ"># Example: Filter out unrealistic values (e.g., negative scores or impossible ages)</span><span class="undefined">
</span><span class="ojrtQ"># Adjust columns and values based on your specific dataset</span><span class="undefined">
</span><span class="uiJ0Tc">if</span><span class="undefined"> </span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined"> </span><span class="uiJ0Tc">in</span><span class="undefined"> df.columns:
    </span><span class="yqj1Pc">df</span><span class="undefined"> = df[(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">] &gt; </span><span class="N1kUHb">0</span><span class="undefined">) &amp; (df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Age</span><span class="dk3nFb">'</span><span class="undefined">] &lt; </span><span class="N1kUHb">100</span><span class="undefined">)]
</span><span class="uiJ0Tc">if</span><span class="undefined"> </span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined"> </span><span class="uiJ0Tc">in</span><span class="undefined"> df.columns:
    </span><span class="yqj1Pc">df</span><span class="undefined"> = df[(df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">] &gt;= </span><span class="N1kUHb">0</span><span class="undefined">) &amp; (df[</span><span class="dk3nFb">'</span><span class="dk3nFb">Exam_Score</span><span class="dk3nFb">'</span><span class="undefined">] &lt;= </span><span class="N1kUHb">100</span><span class="undefined">)]

</span><span class="ojrtQ"># 4. Handle Missing Values</span><span class="undefined">
</span><span class="ojrtQ"># View missing value counts per column</span><span class="undefined">
print(</span><span class="dk3nFb">"</span><span class="dk3nFb">Missing values per column:\n</span><span class="dk3nFb">"</span><span class="undefined">, df.isnull().sum())

</span><span class="ojrtQ"># Fill numerical columns with median or mean</span><span class="undefined">
</span><span class="uiJ0Tc">for</span><span class="undefined"> </span><span class="yqj1Pc">col</span><span class="undefined"> </span><span class="uiJ0Tc">in</span><span class="undefined"> df.select_dtypes(include=[np.number]).columns:
    df[col] = df[col].fillna(df[col].median())

</span><span class="ojrtQ"># Fill categorical columns with the mode (most frequent value)</span><span class="undefined">
</span><span class="uiJ0Tc">for</span><span class="undefined"> </span><span class="yqj1Pc">col</span><span class="undefined"> </span><span class="uiJ0Tc">in</span><span class="undefined"> df.select_dtypes(include=[</span><span class="dk3nFb">'</span><span class="dk3nFb">object</span><span class="dk3nFb">'</span><span class="undefined">]).columns:
    df[col] = df[col].fillna(df[col].mode()[</span><span class="N1kUHb">0</span><span class="undefined">])

</span><span class="ojrtQ"># Save the finalized clean data</span><span class="undefined">
df.to_csv(</span><span class="dk3nFb">'</span><span class="dk3nFb">cleaned_dataset.csv</span><span class="dk3nFb">'</span><span class="undefined">, index=</span><span class="uiJ0Tc">False</span><span class="undefined">)
print(</span><span class="dk3nFb">"</span><span class="dk3nFb">Data cleaning complete. Cleaned file saved as 'cleaned_dataset.csv'.</span><span class="dk3nFb">"</span><span class="undefined">)
</span></code></pre></div></div><div class="iMHp6c" data-animation-atomic="" data-sae="" style=""><div class="ZIumpf">Use code with caution.</div><span jsuid="KJFd7c_3i" jsaction="action:&amp;KJFd7c_3h|ZUljYd" data-ved="2ahUKEwjX45iz9sWXAxWPiuEIHRIONrUQopQPegYIAAgTEAE"><div jsuid="KJFd7c_3k" data-sfc-cp="" jsaction="" jscontroller="cXTEid#e0nEwf" data-sfc-root="ep" data-epip="" data-ved="2ahUKEwjX45iz9sWXAxWPiuEIHRIONrUQh9gSegYIAAgTEAI" data-complete="true"><button jsuid="KJFd7c_3l" class="FTsWP RmjGdc IsqrXb" id="" aria-label="Copy code text to clipboard." data-tooltip-classes="undefined" data-is-tooltip-wrapper="undefined" data-tooltip-id="undefined" aria-describedby="" data-sfc-cp="" jsaction="pointerdown:&amp;KJFd7c_3l|ZUljYd;pointerup:&amp;KJFd7c_3l|aXD3Gb;pointerenter:&amp;KJFd7c_3l|Mrjwi;pointerleave:&amp;KJFd7c_3l|CXhG2e;pointercancel:&amp;KJFd7c_3l|wndyDd;contextmenu:&amp;KJFd7c_3l|yrMC6;click:&amp;KJFd7c_3l|w9rIQb;focus:&amp;KJFd7c_3l|SAMwlb;blur:&amp;KJFd7c_3l|hQOfOb;" data-wiz-attrbind="disabled=KJFd7c_3l/ggNWmb;aria-label=KJFd7c_3l/mCevaf" jscontroller="ETNkje#SiNNTb" data-sfc-root="c" data-complete="true"><span class="XjoK4b kkxvEb" jsaction="" jscontroller="bJ5zY#LlrZ1b" data-sfc-root="c" jsuid="KJFd7c_3m" data-complete="true"><!--TgQPHd|||[]--></span><span jsuid="KJFd7c_3n" class="UTNHae" jsaction="QBlI0e:&amp;KJFd7c_3n|JwG8nd;BTifte:&amp;KJFd7c_3n|ie0cXb;nqgE9d:&amp;KJFd7c_3n|LZznfb;fHTtBd:&amp;KJFd7c_3n|i8hBpd;" data-wiz-attrbind="class=KJFd7c_3n/ggNWmb" jscontroller="MAxPne#DBBRWd" data-sfc-root="c" data-complete="true"><!--TgQPHd|||[{&quot;u&quot;:0},false]--></span><span class="I36Cje" aria-hidden="true"><!--qkimaf KJFd7c_3h/HugV6--><svg aria-hidden="true" fill="currentColor" height="18px" viewBox="0 -960 960 960" width="18px"><path d="M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z"></path></svg><!--cqw1tb KJFd7c_3h/HugV6--></span><div class="ypuoue"></div><!--TgQPHd|||[&quot;Copy code text to clipboard.&quot;,false,{&quot;u&quot;:0},&quot;\u0026KJFd7c_3k:UEmoBd&quot;,{&quot;u&quot;:0}]--></button><!--TgQPHd||GVEHxc=*Q0pj3b|[]--></div></span></div></div><!--TgQPHd|||[[&quot;python&quot;,&quot;import pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\n# 1. Load the raw dataset\n# Replace &#39;raw_data.csv&#39; with your actual file path\ndf \u003d pd.read_csv(&#39;raw_data.csv&#39;)\nprint(\&quot;Initial Shape:\&quot;, df.shape)\n\n# 2. Remove exact duplicates\ndf \u003d df.drop_duplicates()\nprint(\&quot;Shape after removing duplicates:\&quot;, df.shape)\n\n# 3. Handle Outliers\n# Check summary statistics to locate outliers\nprint(df.describe())\n\n# Example: Filter out unrealistic values (e.g., negative scores or impossible ages)\n# Adjust columns and values based on your specific dataset\nif &#39;Age&#39; in df.columns:\n    df \u003d df[(df[&#39;Age&#39;] \u003e 0) \u0026 (df[&#39;Age&#39;] \u003c 100)]\nif &#39;Exam_Score&#39; in df.columns:\n    df \u003d df[(df[&#39;Exam_Score&#39;] \u003e\u003d 0) \u0026 (df[&#39;Exam_Score&#39;] \u003c\u003d 100)]\n\n# 4. Handle Missing Values\n# View missing value counts per column\nprint(\&quot;Missing values per column:\\n\&quot;, df.isnull().sum())\n\n# Fill numerical columns with median or mean\nfor col in df.select_dtypes(include\u003d[np.number]).columns:\n    df[col] \u003d df[col].fillna(df[col].median())\n\n# Fill categorical columns with the mode (most frequent value)\nfor col in df.select_dtypes(include\u003d[&#39;object&#39;]).columns:\n    df[col] \u003d df[col].fillna(df[col].mode()[0])\n\n# Save the finalized clean data\ndf.to_csv(&#39;cleaned_dataset.csv&#39;, index\u003dFalse)\nprint(\&quot;Data cleaning complete. Cleaned file saved as &#39;cleaned_dataset.csv&#39;.\&quot;)\n&quot;,[[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;pandas&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; pd\n&quot;,0],[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;numpy&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; np\n&quot;,0],[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;matplotlib&quot;,24],[&quot;.&quot;,0],[&quot;pyplot&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; plt\n&quot;,0],[&quot;import&quot;,3],[&quot; &quot;,0],[&quot;seaborn&quot;,24],[&quot; &quot;,0],[&quot;as&quot;,3],[&quot; sns\n\n&quot;,0],[&quot;# 1. Load the raw dataset&quot;,5],[&quot;\n&quot;,0],[&quot;# Replace &#39;raw_data.csv&#39; with your actual file path&quot;,5],[&quot;\n&quot;,0],[&quot;df&quot;,24],[&quot; \u003d pd.read_csv(&quot;,0],[&quot;&#39;&quot;,4],[&quot;raw_data.csv&quot;,4],[&quot;&#39;&quot;,4],[&quot;)\nprint(&quot;,0],[&quot;\&quot;&quot;,4],[&quot;Initial Shape:&quot;,4],[&quot;\&quot;&quot;,4],[&quot;, df.shape)\n\n&quot;,0],[&quot;# 2. Remove exact duplicates&quot;,5],[&quot;\n&quot;,0],[&quot;df&quot;,24],[&quot; \u003d df.drop_duplicates()\nprint(&quot;,0],[&quot;\&quot;&quot;,4],[&quot;Shape after removing duplicates:&quot;,4],[&quot;\&quot;&quot;,4],[&quot;, df.shape)\n\n&quot;,0],[&quot;# 3. Handle Outliers&quot;,5],[&quot;\n&quot;,0],[&quot;# Check summary statistics to locate outliers&quot;,5],[&quot;\nprint(df.describe())\n\n&quot;,0],[&quot;# Example: Filter out unrealistic values (e.g., negative scores or impossible ages)&quot;,5],[&quot;\n&quot;,0],[&quot;# Adjust columns and values based on your specific dataset&quot;,5],[&quot;\n&quot;,0],[&quot;if&quot;,3],[&quot; &quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot; &quot;,0],[&quot;in&quot;,3],[&quot; df.columns:\n    &quot;,0],[&quot;df&quot;,24],[&quot; \u003d df[(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003e &quot;,0],[&quot;0&quot;,6],[&quot;) \u0026 (df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003c &quot;,0],[&quot;100&quot;,6],[&quot;)]\n&quot;,0],[&quot;if&quot;,3],[&quot; &quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot; &quot;,0],[&quot;in&quot;,3],[&quot; df.columns:\n    &quot;,0],[&quot;df&quot;,24],[&quot; \u003d df[(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003e\u003d &quot;,0],[&quot;0&quot;,6],[&quot;) \u0026 (df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003c\u003d &quot;,0],[&quot;100&quot;,6],[&quot;)]\n\n&quot;,0],[&quot;# 4. Handle Missing Values&quot;,5],[&quot;\n&quot;,0],[&quot;# View missing value counts per column&quot;,5],[&quot;\nprint(&quot;,0],[&quot;\&quot;&quot;,4],[&quot;Missing values per column:\\n&quot;,4],[&quot;\&quot;&quot;,4],[&quot;, df.isnull().sum())\n\n&quot;,0],[&quot;# Fill numerical columns with median or mean&quot;,5],[&quot;\n&quot;,0],[&quot;for&quot;,3],[&quot; &quot;,0],[&quot;col&quot;,24],[&quot; &quot;,0],[&quot;in&quot;,3],[&quot; df.select_dtypes(include\u003d[np.number]).columns:\n    df[col] \u003d df[col].fillna(df[col].median())\n\n&quot;,0],[&quot;# Fill categorical columns with the mode (most frequent value)&quot;,5],[&quot;\n&quot;,0],[&quot;for&quot;,3],[&quot; &quot;,0],[&quot;col&quot;,24],[&quot; &quot;,0],[&quot;in&quot;,3],[&quot; df.select_dtypes(include\u003d[&quot;,0],[&quot;&#39;&quot;,4],[&quot;object&quot;,4],[&quot;&#39;&quot;,4],[&quot;]).columns:\n    df[col] \u003d df[col].fillna(df[col].mode()[&quot;,0],[&quot;0&quot;,6],[&quot;])\n\n&quot;,0],[&quot;# Save the finalized clean data&quot;,5],[&quot;\ndf.to_csv(&quot;,0],[&quot;&#39;&quot;,4],[&quot;cleaned_dataset.csv&quot;,4],[&quot;&#39;&quot;,4],[&quot;, index\u003d&quot;,0],[&quot;False&quot;,3],[&quot;)\nprint(&quot;,0],[&quot;\&quot;&quot;,4],[&quot;Data cleaning complete. Cleaned file saved as &#39;cleaned_dataset.csv&#39;.&quot;,4],[&quot;\&quot;&quot;,4],[&quot;)\n&quot;,0]]]]--></div><div class="