GDc&quot;,&quot;[false]&quot;]]]" data-ved="2ahUKEwielPv7-sWXAxVIkeEIHb7eDRQQ3KYQegYIAAgEEAE" data-sfc-inited="2"><div style="display: contents" data-container-id="7"><div class="n6owBd awi2gc" data-sfc-cp="" jsaction="" jscontroller="TDBkbc#Ml18Xb" data-sfc-root="ep" data-epip="" jsuid="iDW8Hb_o" data-hveid="CAAIEhAA" data-complete="true" data-processed="true"><span style="display:none;" data-key="aimhl" data-value="" data-animation-skip="" jsaction="" jscontroller="gHKH2d#QRKSy" data-sfc-root="ep" data-epip="" jsuid="iDW8Hb_p" data-complete="true" data-processed="true"><!--TgQPHd|||[]--></span><span data-subtree="aimfl" data-processed="true">You are completely right to notice that—the structure looks very similar because they contain the same category names. However, the data inside them is different! The raw file contains errors, empty gaps, and incorrect data rows (like a student with an age of 150), while the cleaned dataset has completely removed those errors so your graphs can display correctly.</span><span jsuid="iDW8Hb_q" class="DHPVt Wg1cdb notranslate" data-suuid="nCd0md|d0ae8837-5173-450c-86a0-2628d61dddb2-|" jsaction="rcuQ6b:&amp;iDW8Hb_q|npT2md" jscontroller="XqmSxe#JjQTXe" data-sfc-root="ep" data-epip="" data-wiz-uids="iDW8Hb_s,iDW8Hb_r,iDW8Hb_t" data-complete="true" data-processed="true" data-sfc-inited="2"><span class="NMq1me" data-animation-atomic="" jsaction="click:&amp;iDW8Hb_q|ZUljYd" data-sae="" style=""><span aria-hidden="true">&nbsp;</span><span class=""><span class=""><!--qkimaf iDW8Hb_q/HugV6--><!--cqw1tb iDW8Hb_q/HugV6--><button jsuid="iDW8Hb_r" tabindex="0" data-amic="true" data-icl-uuid="d0ae8837-5173-450c-86a0-2628d61dddb2" aria-label="Related results" class="vDOt8c" jsaction="click:&amp;iDW8Hb_q|CXhG2e;mouseenter:&amp;iDW8Hb_q|wndyDd;mouseleave:&amp;iDW8Hb_q|yrMC6" data-ved="2ahUKEwielPv7-sWXAxVIkeEIHb7eDRQQye0OegYIAAgSEAE" data-hveid="CAAIEhAB"><span class="pxxQye T6UJT"><div class="a14YJe"><svg class="EQxvpc MZhYme" fill="currentColo