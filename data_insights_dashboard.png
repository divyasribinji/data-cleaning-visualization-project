],[&quot;\ndf[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003d df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;].fillna(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;].median())\ndf[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Study_Hours&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003d df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Study_Hours&quot;,4],[&quot;&#39;&quot;,4],[&quot;].fillna(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Study_Hours&quot;,4],[&quot;&#39;&quot;,4],[&quot;].median())\ndf[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;] \u003d df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;].fillna(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Exam_Score&quot;,4],[&quot;&#39;&quot;,4],[&quot;].median())\n\n&quot;,0],[&quot;# 5. Export finalized clean dataset &quot;,5],[&quot;\ndf.to_csv(&quot;,0],[&quot;&#39;&quot;,4],[&quot;cleaned_dataset.csv&quot;,4],[&quot;&#39;&quot;,4],[&quot;, index\u003d&quot;,0],[&quot;False&quot;,3],[&quot;)\nprint(&quot;,0],[&quot;\&quot;&quot;,4],[&quot;Cleaned dataset successfully created!&quot;,4],[&quot;\&quot;&quot;,4],[&quot;)\n\n&quot;,0],[&quot;# 6. Generate exploratory visualization report dashboard&quot;,5],[&quot;\nsns.set_theme(style\u003d&quot;,0],[&quot;\&quot;&quot;,4],[&quot;darkgrid&quot;,4],[&quot;\&quot;&quot;,4],[&quot;)\n&quot;,0],[&quot;fig&quot;,24],[&quot;, &quot;,0],[&quot;axes&quot;,24],[&quot; \u003d plt.subplots(&quot;,0],[&quot;1&quot;,6],[&quot;, &quot;,0],[&quot;2&quot;,6],[&quot;, figsize\u003d(&quot;,0],[&quot;12&quot;,6],[&quot;, &quot;,0],[&quot;5&quot;,6],[&quot;))\n\n&quot;,0],[&quot;# Plot A: Age spread mapping&quot;,5],[&quot;\nsns.histplot(df[&quot;,0],[&quot;&#39;&quot;,4],[&quot;Age&quot;,4],[&quot;&#39;&quot;,4],[&quot;], bins\u003d&quot;,0],[&quot;6&quot;,6],[&quot;, kde\u003d&quot;,0],[&quot;True&quot;,3],[